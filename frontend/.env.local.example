# PRAKIRA Frontend — Environment Variables
# Salin ke .env.local lalu isi. JANGAN commit .env.local (sudah di-gitignore).
#
# Semua variabel di bawah opsional untuk pengembangan lokal: bila kosong,
# frontend otomatis memakai data mock di src/lib/mock-data.ts.

# Express gateway base URL. Dipakai src/lib/api.ts dan di-proxy oleh
# next.config.mjs untuk seluruh permintaan /api/*.
NEXT_PUBLIC_API_URL=http://localhost:4200

# Supabase (Project Settings -> API). Anon key bersifat publik dan aman
# dipublikasikan — perlindungan data ada di Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
