{
  "name": "prakira-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prakira API gateway — auth, data kasus & iklim, prediksi, laporan warga, audit trail",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "test": "node --import ./tests/setup.mjs --import tsx --test \"tests/**/*.test.ts\"",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
