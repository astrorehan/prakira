# Salin ke backend/.env lalu isi.

# Supabase: Project Settings > Database > Connection string > Session pooler.
# Harus Session pooler (5432). Transaction pooler (6543) tidak mendukung
# prepared statement; direct connection hanya IPv6 sedangkan Render IPv4.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=5
# Sertifikat CA Supabase: Project Settings > Database > SSL Configuration >
# Download certificate. Simpan di backend/certs/ (diabaikan git).
DATABASE_CA_CERT_PATH=certs/prod-ca-2021.crt

# Akun dinas pertama. Wajib saat NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@prakira.id
SEED_ADMIN_PASSWORD=
# Wajib juga di produksi; nilai bawaan hanya tersedia saat pengembangan.
SEED_DINKES_PASSWORD=
SEED_PUSKESMAS_PASSWORD=

# Kosong di dev (diacak per proses). Wajib di produksi.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

ML_SERVICE_URL=http://127.0.0.1:8001
ML_API_TOKEN=
ML_TIMEOUT_MS=20000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pengiriman email rujukan. Isi kredensial akun pengirim di server saja.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Semua rujukan lingkungan masuk hanya ke inbox pengelola ini.
REPORT_EMAIL_TO=
